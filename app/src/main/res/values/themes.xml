<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de la fenêtre seulement : l'interface est en Compose (MaterialTheme). -->
    <style name="Theme.Mediatheque" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Écran de lancement : icône blanche sur le magenta de la ville. -->
    <style name="Theme.Mediatheque.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_magenta</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mediatheque</item>
    </style>
</resources>
