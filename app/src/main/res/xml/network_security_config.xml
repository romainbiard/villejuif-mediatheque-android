<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system authorities only. In debug, user-added authorities
     are accepted to inspect traffic to the portal (local proxy). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
