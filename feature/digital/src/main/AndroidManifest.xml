<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The partner apps the digital tab opens or offers to install (DigitalCatalog), checked on the Play Store.
         Package visibility for these only: never QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="fr.artefrance.offline_player_android.mednum" />
        <package android:name="fr.lekiosque" />
        <package android:name="com.toutapprendre" />
        <package android:name="com.numilog.louise" />
        <package android:name="fr.airweb.izneo" />
        <package android:name="com.apachenetwork.musicme.mediatheque" />
        <!-- The Play Store, for the apps' pages. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

</manifest>
