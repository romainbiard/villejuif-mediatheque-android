<?xml version="1.0" encoding="UTF-8"?>
<!-- Strict lint (warnings = errors), except for what depends on the calendar rather than the code:
     new dependency versions arrive through Renovate, not through a broken build. -->
<lint>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Lint rules bundled in a library (lifecycle-runtime 2.11) that do not run
         with this AGP's lint: lint ignores them itself; this is not a defect in our code. -->
    <issue id="ObsoleteLintCustomCheck" severity="informational" />
</lint>
