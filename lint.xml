<?xml version="1.0" encoding="UTF-8"?>
<!-- Lint strict (avertissements = erreurs), sauf ce qui dépend du calendrier et non du code :
     les nouvelles versions des dépendances arrivent par Renovate, pas par un build cassé. -->
<lint>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Règles lint embarquées dans une bibliothèque (lifecycle-runtime 2.11) qui ne tournent pas
         avec le lint de cet AGP : lint les ignore lui-même ; ce n'est pas un défaut de notre code. -->
    <issue id="ObsoleteLintCustomCheck" severity="informational" />
</lint>
