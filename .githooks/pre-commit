set -euo pipefail

# 1. Repo-specific identity: never the machine's global identity by accident.
if [[ -z "$(git config --local user.email || true)" ]]; then
    echo "✖ No local identity. Run this in this repo:" >&2
    echo "    git config --local user.name  \"Your name\"" >&2
    echo "    git config --local user.email \"you@example.com\"" >&2
    exit 1
fi

# 2. Secrets (keys, tokens, passwords).
if ! command -v gitleaks >/dev/null; then
    echo "✖ gitleaks not found: brew install gitleaks" >&2
    exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn

# 3. Personal data (emails, phone numbers, card numbers, cookies, home directory paths).
"$(git rev-parse --show-toplevel)/scripts/check-personal-data.sh"

# 4. Source code comments in US English.
python3 -I "$(git rev-parse --show-toplevel)/scripts/check_english_comments.py"
